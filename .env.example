# Optional bearer token used only when an endpoint requires authentication.
NVIDIA_API_KEY=

# Local OpenAI-compatible NVIDIA model services.
NVIDIA_PARSE_BASE_URL=http://127.0.0.1:8001
NVIDIA_LLM_BASE_URL=http://127.0.0.1:8003
NVIDIA_EMBEDDING_BASE_URL=http://127.0.0.1:8004

# Use OpenAI-compatible response_format JSON Schema with the supplied vLLM launcher.
NVIDIA_LLM_GUIDED_JSON_MODE=openai_response_format

# Durable Linux data root used by the operational scripts.
INDUSTRIAL_DATA_ROOT=/data/industrial-data-corps
